# GEMINI_API_KEY: Required for Gemini AI strategy report generation.
# Kept strictly server-side in server.ts (never exposed to browser client).
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Optional service URL for production hosting
APP_URL="http://localhost:3000"

# Firebase SDK Client Configuration
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
