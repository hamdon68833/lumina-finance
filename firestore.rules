rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped data: Only authenticated owner can read or write their document tree
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default fallback: Block unauthenticated access to private database paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
